<?xml version="1.0" encoding="utf-8"?>
<!-- 매뉴얼·서식(풀어 둔 파일)과 인증키는 백업·기기 이전에 넣지 않는다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="library/"/>
        <exclude domain="file" path="settings.json"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="library/"/>
        <exclude domain="file" path="settings.json"/>
    </device-transfer>
</data-extraction-rules>
